# PayFlow classic replication: shared by the primary and both replicas.
# server_id and report_host differ per server and are passed on the command line.
# Replicas are made read-only by setup.sh (SET PERSIST), not here: the image's
# first-start initialisation has to write to them.

[mysqld]
# --- replication ---
gtid_mode                   = ON
enforce_gtid_consistency    = ON
log_bin                     = binlog
log_replica_updates         = ON            # replicas keep a binlog too, so any can be promoted
binlog_expire_logs_seconds  = 604800
replica_parallel_workers    = 4             # apply in parallel (WRITESET dependency tracking)
replica_preserve_commit_order = ON          # ...but commit in the primary's order
relay_log_recovery          = ON            # discard a half-written relay log after a crash

# --- durability ---
innodb_flush_log_at_trx_commit = 1
sync_binlog                    = 1

# --- sized for three servers in one 4 GB Docker VM ---
innodb_buffer_pool_size     = 256M
innodb_redo_log_capacity    = 256M
max_connections             = 200

# --- same correctness/security basics as Phase 1 ---
character_set_server        = utf8mb4
collation_server            = utf8mb4_0900_ai_ci
default_time_zone           = '+00:00'
skip_name_resolve           = ON
local_infile                = OFF
