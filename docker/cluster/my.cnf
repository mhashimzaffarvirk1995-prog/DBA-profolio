# PayFlow InnoDB Cluster node config (all three nodes).
# server_id and report_host are passed per node on the command line; the
# Group Replication settings themselves are written by MySQL Shell's AdminAPI
# (dba.configureInstance / createCluster) and persisted in mysqld-auto.cnf.

[mysqld]
# --- prerequisites for Group Replication ---
gtid_mode                   = ON
enforce_gtid_consistency    = ON
log_bin                     = binlog
log_replica_updates         = ON
binlog_expire_logs_seconds  = 604800
# Group Replication needs transactional tables with primary keys everywhere.
disabled_storage_engines    = "MyISAM,BLACKHOLE,FEDERATED,ARCHIVE,MEMORY"

# --- durability ---
innodb_flush_log_at_trx_commit = 1
sync_binlog                    = 1

# --- sized for three nodes in one 4 GB Docker VM ---
innodb_buffer_pool_size     = 256M
innodb_redo_log_capacity    = 256M
max_connections             = 200

# --- same basics as Phase 1 ---
character_set_server        = utf8mb4
collation_server            = utf8mb4_0900_ai_ci
default_time_zone           = '+00:00'
skip_name_resolve           = ON
local_infile                = OFF
