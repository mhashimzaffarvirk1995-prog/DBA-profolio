# PayFlow standalone server config (MySQL 8.4 LTS).
# Deliberately close to defaults where tuning is a later phase's job, so the
# performance phase has an honest "before" to measure against.

[mysqld]
# --- identity / replication readiness (Phase 2 builds on these) ---
server_id                   = 1
gtid_mode                   = ON
enforce_gtid_consistency    = ON
log_bin                     = binlog
binlog_expire_logs_seconds  = 604800        # 7 days; Phase 3 archives binlogs for PITR

# --- durability: a payments ledger never trades these away ---
innodb_flush_log_at_trx_commit = 1
sync_binlog                    = 1

# --- memory: sized in Phase 4 from the measured hot working set (last 90 days
# of transactions + ledger = 1.3 GB now, 2.0 GB in 12 months; see
# docs/04-performance-tuning.md). Was 1G. Resizable online with SET GLOBAL.
innodb_buffer_pool_size     = 2G
innodb_redo_log_capacity    = 1G

# --- correctness ---
character_set_server        = utf8mb4
collation_server            = utf8mb4_0900_ai_ci
default_time_zone           = '+00:00'      # store and compare everything in UTC
transaction_isolation       = REPEATABLE-READ

# --- connections / security basics (hardened further in the security phase) ---
max_connections             = 300
skip_name_resolve           = ON
local_infile                = OFF           # the bulk loader enables it for the load only
secure_file_priv            = /var/lib/mysql-files
