# `make .env` fills in random values for every key below. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me
REPL_PASSWORD=change-me            # replication user (Phase 2, classic replication)
CLUSTER_ADMIN_PASSWORD=change-me   # InnoDB Cluster admin account (Phase 2)
BACKUP_PASSWORD=change-me          # backup account: XtraBackup, dumps, binlog archiver (Phase 3)
EXPORTER_PASSWORD=change-me        # mysqld_exporter's read-only account (Phase 5)
GRAFANA_ADMIN_PASSWORD=change-me   # Grafana admin login (Phase 5)

APP_PASSWORD=
REPORT_PASSWORD=
AUDITOR_PASSWORD=
AUDIT_HMAC_KEY=
BENCH_PASSWORD=
